        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "agenty-core": "workspace:*",
        "typescript": "^6.0.3"
    }
