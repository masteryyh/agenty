{
    "name": "agenty-core",
    "private": true,
    "scripts": {
        "build": "node scripts/build.mjs",
        "test": "node --test scripts/build.test.mjs && node ../../scripts/go.mjs test ./...",
        "test:integration": "node ../../scripts/go.mjs test -tags=integration ./...",
        "test:e2e": "node ../../scripts/go.mjs test -tags=e2e -count=1 -parallel=8 ./test/e2e",
        "test:e2e:race": "node ../../scripts/go.mjs test -race -tags=e2e -count=1 -parallel=4 ./test/e2e",
        "test:race": "node ../../scripts/go.mjs test -race -count=1 ./...",
        "test:repeat": "node ../../scripts/go.mjs test -shuffle=on -count=10 ./...",
        "vet": "node ../../scripts/go.mjs vet ./...",
        "fmt": "go fmt ./...",
        "clean": "rm -rf bin"
    },
    "devDependencies": {
        "llm-codec": "workspace:*",
        "file-editor": "workspace:*"
    }
}
