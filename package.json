{
    "name": "agenty",
    "private": true,
    "scripts": {
        "build": "node scripts/build.mjs",
        "test": "node --test scripts/*.test.mjs && node scripts/turbo.mjs test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "update": "node scripts/update.mjs",
        "clean": "node scripts/clean.mjs",
        "dev": "node scripts/dev.mjs",
        "deepclean": "node scripts/clean.mjs deepclean",
        "core:build": "node scripts/build.mjs agenty-core",
        "core:test": "node scripts/turbo.mjs test agenty-core",
        "core:test:integration": "pnpm --filter agenty-core test:integration",
        "core:test:e2e": "pnpm --filter agenty-core test:e2e",
        "core:test:e2e:race": "pnpm --filter agenty-core test:e2e:race",
        "core:test:race": "pnpm --filter agenty-core test:race",
        "core:test:repeat": "pnpm --filter agenty-core test:repeat",
        "core:tidyup": "node scripts/tidyup.mjs agenty-core",
        "core:clean": "pnpm --filter agenty-core clean",
        "file-editor:build": "node scripts/build.mjs file-editor",
        "file-editor:test": "node scripts/turbo.mjs test file-editor",
        "file-editor:lint": "pnpm --filter file-editor lint",
        "file-editor:clean": "pnpm --filter file-editor clean",
        "cli:build": "node scripts/build.mjs agenty-cli",
        "cli:dev": "node scripts/turbo.mjs build agenty-core && pnpm --filter agenty-cli dev",
        "cli:typecheck": "pnpm --filter agenty-cli typecheck",
        "cli:clean": "pnpm --filter agenty-cli clean",
        "bootstrap:build": "node scripts/build.mjs agenty-bootstrap",
        "bootstrap:test": "node scripts/turbo.mjs test agenty-bootstrap",
        "bootstrap:clean": "pnpm --filter agenty-bootstrap clean",
        "inspector:dev": "pnpm --filter agenty-inspector dev",
        "inspector:build": "node scripts/build.mjs agenty-inspector",
        "inspector:start": "pnpm --filter agenty-inspector start",
        "inspector:test": "pnpm --filter agenty-inspector test",
        "inspector:typecheck": "pnpm --filter agenty-inspector typecheck",
        "tidyup": "node scripts/tidyup.mjs"
    },
    "packageManager": "pnpm@12.3.4",
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.10.0",
        "eslint-plugin-import-newlines": "^2.0.0",
        "eslint-plugin-jsonc": "^3.4.2",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "turbo": "^2.10.12",
        "typescript-eslint": "^8.70.0"
    }
}
