{
    "$schema": "https://v2-10-11.turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["bin/**", "dist/**"],
            "env": ["AGENTY_VERSION", "CGO_ENABLED", "GOOS", "GOARCH", "CC", "CXX", "GOCACHE", "PACKAGE_DIR", "BIN_NAME"]
        },
        "agenty-cli#build": {
            "dependsOn": ["^build"],
            "cache": false,
            "env": ["AGENTY_VERSION", "OS", "ARCH", "OPENTUI_LIBC"]
        },
        "agenty-bootstrap#build": {
            "dependsOn": ["^build"],
            "cache": false,
            "env": ["AGENTY_VERSION", "OS", "ARCH"],
            "passThroughEnv": ["HOME", "CARGO_HOME", "RUSTUP_HOME"],
            "outputs": ["dist/**"]
        },
        "patch-applier#build": {
            "cache": false,
            "passThroughEnv": ["HOME", "CARGO_HOME", "RUSTUP_HOME"],
            "outputs": ["target/release/apply_patch", "target/release/apply_patch.exe"]
        },
        "agenty-bootstrap#test": {
            "passThroughEnv": ["HOME", "CARGO_HOME", "RUSTUP_HOME"]
        },
        "patch-applier#test": {
            "passThroughEnv": ["HOME", "CARGO_HOME", "RUSTUP_HOME"]
        },
        "test": {
            "dependsOn": ["^build"],
            "env": ["GOCACHE"]
        },
        "lint": {},
        "clean": {
            "cache": false
        },
        "typecheck": {}
    }
}
