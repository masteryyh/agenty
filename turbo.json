{
    "$schema": "https://v2-10-12.turborepo.dev/schema.json",
    "globalDependencies": [".env"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["bin/**", "dist/**"],
            "env": ["AGENTY_VERSION", "CGO_ENABLED", "GOOS", "GOARCH", "CC", "CXX", "PACKAGE_DIR", "BIN_NAME"],
            "passThroughEnv": ["GOCACHE", "LOCALAPPDATA"]
        },
        "agenty-cli#build": {
            "dependsOn": ["^build"],
            "inputs": [
                "package.json",
                "scripts/**",
                "!scripts/**/*.test.*",
                "src/**",
                "!src/**/*.test.*",
                "tsconfig*.json",
                "$TURBO_ROOT$/scripts/build-version.mjs",
                "$TURBO_ROOT$/.env"
            ],
            "outputs": ["bin/**"],
            "env": ["AGENTY_VERSION", "OS", "ARCH", "OPENTUI_LIBC"]
        },
        "agenty-bootstrap#build": {
            "dependsOn": ["^build"],
            "inputs": [
                "Cargo.toml",
                "Cargo.lock",
                "package.json",
                "scripts/build.mjs",
                "scripts/pack.ts",
                "scripts/target.ts",
                "scripts/footer.ts",
                "src/**",
                "$TURBO_ROOT$/scripts/build-version.mjs",
                "$TURBO_ROOT$/.env"
            ],
            "env": ["AGENTY_VERSION", "OS", "ARCH"],
            "passThroughEnv": ["HOME", "CARGO_HOME", "RUSTUP_HOME"],
            "outputs": ["bin/**"]
        },
        "agenty-core#build": {
            "dependsOn": ["^build"],
            "inputs": [
                "go.mod",
                "go.sum",
                "package.json",
                "cmd/**/*.go",
                "!cmd/**/*_test.go",
                "pkg/**/*.go",
                "!pkg/**/*_test.go",
                "scripts/build.mjs",
                "$TURBO_ROOT$/scripts/build-version.mjs",
                "$TURBO_ROOT$/.env"
            ],
            "outputs": ["bin/**"],
            "env": ["AGENTY_VERSION", "CGO_ENABLED", "GOOS", "GOARCH", "CC", "CXX", "PACKAGE_DIR", "BIN_NAME"],
            "passThroughEnv": ["GOCACHE", "LOCALAPPDATA"]
        },
        "file-editor#build": {
            "inputs": [
                "Cargo.toml",
                "Cargo.lock",
                "package.json",
                "src/**",
                "$TURBO_ROOT$/scripts/build-version.mjs",
                "$TURBO_ROOT$/.env"
            ],
            "env": ["OS", "ARCH"],
            "passThroughEnv": ["HOME", "CARGO_HOME", "RUSTUP_HOME"],
            "outputs": ["target/release/fileedit", "target/release/fileedit.exe"]
        },
        "agenty-bootstrap#test": {
            "passThroughEnv": ["HOME", "CARGO_HOME", "RUSTUP_HOME"]
        },
        "file-editor#test": {
            "passThroughEnv": ["HOME", "CARGO_HOME", "RUSTUP_HOME"]
        },
        "test": {
            "dependsOn": ["^build"],
            "passThroughEnv": ["GOCACHE", "LOCALAPPDATA"]
        },
        "lint": {},
        "clean": {
            "cache": false
        },
        "typecheck": {},
        "agenty-inspector#build": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/packages/agenty-core/**/*.go",
                "$TURBO_ROOT$/packages/agenty-core/go.mod",
                "$TURBO_ROOT$/packages/agenty-core/go.sum"
            ],
            "outputs": [
                "bin/**",
                "web/dist/**"
            ],
            "env": [
                "AGENTY_VERSION",
                "CGO_ENABLED",
                "GOOS",
                "GOARCH",
                "CC",
                "CXX"
            ],
            "passThroughEnv": ["GOCACHE", "LOCALAPPDATA"]
        },
        "agenty-inspector#test": {
            "dependsOn": [],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/packages/agenty-core/**/*.go",
                "$TURBO_ROOT$/packages/agenty-core/go.mod",
                "$TURBO_ROOT$/packages/agenty-core/go.sum"
            ],
            "passThroughEnv": ["GOCACHE", "LOCALAPPDATA"]
        }
    }
}
